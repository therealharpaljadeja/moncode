# Privy app ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy app secret for server-side auth (Dashboard → Settings → Basics)
PRIVY_APP_SECRET=

# PostgreSQL connection string (Neon, Supabase, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/moncode

# Anthropic API key — passed into the sandbox so the Claude Agent SDK can authenticate.
ANTHROPIC_API_KEY=

# Vercel Sandbox auth (access-token method). For local dev, run `vercel link`
# and `vercel env pull` to use OIDC instead and skip these.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# Curated skills bundle the sandbox clones on first boot.
MONCODE_MONSKILLS_GIT_URL=https://github.com/therealharpaljadeja/monskills

# Nango — GitHub OAuth via https://nango.dev (Environment settings → API Keys)
NANGO_SECRET_KEY=
# Integration unique key from Nango dashboard (e.g. github or github-app-oauth).
# GitHub App / OAuth client credentials go in the Nango integration settings —
# Moncode does not read GITHUB_CLIENT_ID or GITHUB_APP_* from this file.
NANGO_GITHUB_INTEGRATION_ID=github
# Nango webhook signing key (Environment Settings → Webhooks → Signing key).
# Not the same as NANGO_SECRET_KEY. Leave unset to skip verification (e.g. local dev).
NANGO_WEBHOOK_SECRET=

# Public URL of this Moncode app — required for sandbox → host GitHub API calls.
# Local dev: use your tunnel URL (e.g. ngrok) since the Vercel sandbox cannot reach localhost.
MONCODE_API_BASE_URL=http://localhost:3000

# Shared secret between sandbox agent and host API routes (/api/github/op)
MONCODE_AGENT_SECRET=
